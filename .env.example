# ===== 复制为 .env 后填写真实值 =====
# cp .env.example .env

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# deepseek-chat(快,直播首选) / deepseek-reasoner(慢,慎用)
DEEPSEEK_MODEL=deepseek-chat
# 回复长度上限(中文 token)，直播建议 60~100
DEEPSEEK_MAX_TOKENS=80
DEEPSEEK_TEMPERATURE=0.8
# 流式生成 + 按句合成语音：第一句生成完就开口（1=开，0=整段生成完再合成）
DEEPSEEK_STREAM=1
# 让回复以 [开心] 这类情绪标签开头，驱动 Live2D 表情（标签不念、不显示）
EMOTION_TAGS=1

# --- Vidu 开放平台(云渲染 + 云端 TTS) ---
# 控制台 https://platform.vidu.cn 申请的 API Key(即 Token)
VIDU_API_KEY=xxxxxxxxxxxxxxxx
# 云端 TTS 音色 ID（默认/兜底音色），见 Vidu 音色列表确认取值
VIDU_TTS_VOICE_ID=your_voice_id
# 弹幕指定音色映射(JSON)：弹幕里出现关键词就切换音色，value 填各音色的 voice_id
# VOICE_MAP={"御姐":"voice_id_1","萝莉":"voice_id_2","男声":"voice_id_3"}
# 数字人"底片"视频(公网可访问 URL, mp4/mov/avi, H.264, 人脸正对镜头)
VIDU_AVATAR_VIDEO_URL=https://your-storage/avatar_base.mp4

# --- 本地 TTS ---
# auto   : 按平台自动选（有 Piper 用 Piper，否则 macOS=say / Windows=sapi）—— 推荐
# piper  : 本地 Piper 模型，音质最好（需额外下载模型）
# say    : macOS 原生 say
# sapi   : Windows 原生 SAPI5，零安装
# vidu   : 云端对口型（走 Vidu，见上）
TTS_BACKEND=auto

# macOS `say` 音色（仅 say 后端用）
SAY_VOICE=Tingting
# 弹幕关键词 -> macOS say 音色(JSON)
# SAY_VOICE_MAP={"御姐":"Tingting","萝莉":"Flo","男声":"Eddy"}

# Windows SAPI 音色（仅 sapi 后端用）。留空则自动挑第一个中文音色。
# 查本机音色名：python tts_backend.py --list-voices
WIN_VOICE=
# 弹幕关键词 -> Windows SAPI 音色(JSON)
# WIN_VOICE_MAP={"御姐":"Microsoft Huihui Desktop","男声":"Microsoft Kangkang"}
# 单条朗读文本上限（字符），防止异常超长输入
SAPI_TTS_MAX_CHARS=800

# 让 transformers/piper 走本地缓存不联网(否则 bert tokenizer 会卡在联网验证)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- 数字人桥(编排器) ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
# 请求体上限(字节)
BRIDGE_MAX_BODY=8192
# 只读视图令牌：仅用于保护 GET（页面/状态/音频/视频）。
# 写入口 /api/danmaku 只允许本机访问，所以令牌泄漏也不会被人刷 API 额度。
# 绑非回环地址（如 0.0.0.0）时必填，且至少 16 位；用 http://<ip>:8000/?token=xxx 打开页面。
# BRIDGE_TOKEN=
# 绑非回环地址又不想设令牌时，显式接受「局域网可只读访问」
# BRIDGE_ALLOW_UNAUTHENTICATED=1

# 两条回复之间最少间隔(秒)；礼物感谢不受限
BRIDGE_MIN_INTERVAL=3
# 排队上限；满了会挤掉优先级最低里最旧的一条，礼物永远能进
BRIDGE_MAX_QUEUE=20
# 普通弹幕排队超过 N 秒就不再回复（观众多半已经走了）
BRIDGE_CHAT_TTL=30
# 礼物感谢的排队上限(秒)
BRIDGE_GIFT_TTL=120

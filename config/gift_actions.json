{
  "_comment": "礼物行为规则：按 priority 从高到低匹配；timeline 是相对动作开始的时间轴（秒）。当前默认按 Hiyori 的 TapBody[0] 编写，换模型先运行 inspect_live2d.py。 on_cooldown: 规则全局冷却中时 fallthrough=降级到下一条匹配规则 / queue=排队等候（大礼物用，保证不丢）；queue_ttl: 排队最长等待秒数。",
  "version": 1,
  "defaults": {
    "duration": 2.4,
    "priority": 10,
    "cooldown": 0,
    "user_cooldown": 0,
    "interruptible": true,
    "on_cooldown": "fallthrough",
    "queue_ttl": 10
  },
  "rules": [
    {
      "id": "gift_carnival",
      "label": "嘉年华",
      "match": { "names": ["嘉年华"] },
      "priority": 100,
      "cooldown": 20,
      "interruptible": false,
      "on_cooldown": "queue",
      "queue_ttl": 60,
      "duration": 5.0,
      "timeline": [
        { "at": 0, "type": "effect", "name": "fireworks", "duration": 3.5 },
        { "at": 0.2, "type": "toast", "text": "🎆 {nick} 送出 {gift} x{count}！", "duration": 3.5 },
        { "at": 0.8, "type": "effect", "name": "confetti", "duration": 3.0 }
      ]
    },
